# Copy these into GitHub -> your repo -> Settings -> Secrets and variables -> Actions -> New repository secret.
# DO NOT commit a real .env with real values -- it's already in .gitignore.

ANTHROPIC_API_KEY=sk-ant-...        # from https://console.anthropic.com
BEEHIIV_API_KEY=...                 # Beehiiv -> workspace settings -> Integrations -> API
OPENAI_API_KEY=sk-...               # https://platform.openai.com/api-keys (for DALL-E 3 header images)
GMAIL_ADDRESS=you@gmail.com         # your own Gmail -- used to send yourself the LinkedIn draft
GMAIL_APP_PASSWORD=xxxxxxxxxxxxxxxx # https://myaccount.google.com/apppasswords (App Password, NOT your login password. Requires 2FA.)
GIPHY_API_KEY=...                   # optional -- https://developers.giphy.com (free). Powers GIF issues. Without it, every issue falls back to a static image.

# Optional -- only if you keep your own research catalog in Notion (recommended
# if you want the drafter grounded in things you noticed, not just live search):
NOTION_API_KEY=ntn_...               # notion.so/profile/integrations -- Read content only
NOTION_PAGE_ID=...                   # the 32-char hex ID from your research page's URL
